# Lente: direct USB access to Elgato cameras (vendor 0fd9) for the logged-in user
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0fd9", TAG+="uaccess"
# No USB power saving: after waking, the camera rejects commands for half a second
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0fd9", TEST=="power/control", ATTR{power/control}="on"
#
# Install:
#   sudo cp 70-lente-elgato.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
# Then unplug the camera and plug it back in.
